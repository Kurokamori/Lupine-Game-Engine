#shader "Text3D"
#description "3D text rendering with alpha discard"

#begin properties
    uniform mat4 u_ViewProjection;
    uniform mat4 u_Model;
    uniform vec4 u_TintColor = vec4(1.0);
    uniform sampler2D u_FontAtlas;
#end properties

#begin vertex
    #input vec3 a_Position : POSITION 0
    #input vec3 a_Normal : NORMAL 1
    #input vec2 a_TexCoord : TEXCOORD0 2
    #input vec4 a_Color : COLOR 3

    #output vec2 v_TexCoord
    #output vec4 v_Color

    void main() {
        vec4 worldPos = MUL(u_Model, vec4(a_Position, 1.0));
        v_TexCoord = a_TexCoord;
        v_Color = a_Color;
        VERTEX_OUTPUT = MUL(u_ViewProjection, worldPos);
    }
#end vertex

#begin fragment
    #output vec4 FragColor

    void main() {
        float alpha = SAMPLE(u_FontAtlas, v_TexCoord).r;

        if (alpha < 0.01) {
            DISCARD;
        }

        vec4 finalColor = v_Color * u_TintColor;
        FragColor = vec4(finalColor.rgb, finalColor.a * alpha);
    }
#end fragment
