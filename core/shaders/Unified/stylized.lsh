#shader "Stylized"
#description "Fantasy/stylized shading with half-Lambert diffuse, warm shadow ramps, and soft specular"

#feature lighting
#feature shadows
#feature normal_mapping
#feature fog

#begin properties
    uniform mat4 u_ViewProjection;
    uniform mat4 u_View;
    uniform mat4 u_Model;
    uniform mat4 u_NormalMatrix;
    uniform vec3 u_CameraPosition = vec3(0.0);
    uniform vec4 u_TintColor = vec4(1.0);

    uniform vec4 u_AlbedoColor = vec4(1.0);
    uniform vec4 u_EmissiveColor = vec4(0.0);
    uniform vec4 u_TextureFlags = vec4(0.0);
    uniform vec4 u_MaterialParams1 = vec4(0.3, 0.15, 1.0, 1.0);
    uniform vec4 u_MaterialParams2 = vec4(0.0, 2.5, 0.0, 24.0);
    uniform vec4 u_StylizedParams = vec4(0.4, 0.5, 0.5, 1.5);
    uniform int u_ReceiveShadow = 1;

    uniform sampler2D u_AlbedoTexture;
    uniform sampler2D u_NormalTexture;
    uniform sampler2D u_EmissiveTexture;
    uniform sampler2D u_ShadowRampTexture;
#end properties

#begin shared
    // Half-Lambert diffuse for softer shading
    float halfLambert(float NdotL, float power) {
        float wrapped = NdotL * 0.5 + 0.5;
        return pow(wrapped, power);
    }

    // Soft step for smooth transitions
    float softStep(float edge0, float edge1, float x) {
        float t = clamp((x - edge0) / (edge1 - edge0), 0.0, 1.0);
        return t * t * (3.0 - 2.0 * t);
    }

    // Calculate rim lighting (fresnel-based edge glow)
    float calculateRimLighting(vec3 N, vec3 V, float rimPower, float rimIntensity) {
        float rim = 1.0 - max(dot(N, V), 0.0);
        rim = pow(rim, rimPower) * rimIntensity;
        return rim;
    }

    // Apply shadow ramp (procedural warm-to-cool color shift)
    vec3 applyShadowRamp(float lightAmount, vec3 baseColor, float shadowBrightness, float shadowWarmth) {
        // Procedural shadow ramp with warmth control
        vec3 warmShift = vec3(1.0, 0.9, 0.8);
        vec3 coolShift = vec3(0.8, 0.85, 1.0);
        vec3 colorShift = mix(coolShift, warmShift, lightAmount);
        colorShift = mix(vec3(1.0), colorShift, shadowWarmth);
        float shadowFactor = mix(shadowBrightness, 1.0, lightAmount);
        return baseColor * colorShift * shadowFactor;
    }

    // Soft specular highlight calculation
    float calculateSpecular(vec3 N, vec3 V, vec3 L, float specularPower, float specularSoftness, float NdotL) {
        vec3 H = normalize(V + L);
        float NdotH = max(dot(N, H), 0.0);
        float specularRaw = pow(NdotH, specularPower);
        float specularThreshold = 0.5;
        float specular = softStep(specularThreshold - specularSoftness,
                                  specularThreshold + specularSoftness,
                                  specularRaw);
        return specular * smoothstep(0.0, 0.3, NdotL);
    }
#end shared

#begin vertex
    #input vec3 a_Position : POSITION 0
    #input vec3 a_Normal : NORMAL 1
    #input vec2 a_TexCoord : TEXCOORD0 2
    #input vec4 a_Color : COLOR 3

    #output vec3 v_WorldPos
    #output vec3 v_ViewPos
    #output vec3 v_Normal
    #output vec2 v_TexCoord
    #output vec4 v_Color
    #output vec3 v_ViewDir

    void main() {
        vec4 worldPos = MUL(u_Model, vec4(a_Position, 1.0));
        v_WorldPos = worldPos.xyz;
        v_ViewPos = MUL(u_View, worldPos).xyz;
        v_Normal = MUL(MAT3(u_NormalMatrix), a_Normal);
        v_TexCoord = a_TexCoord;
        v_Color = a_Color;
        v_ViewDir = normalize(u_CameraPosition.xyz - worldPos.xyz);
        VERTEX_OUTPUT = MUL(u_ViewProjection, worldPos);
    }
#end vertex

#begin fragment
    #output vec4 FragColor

    void main() {
        // Sample albedo texture
        vec4 albedo = u_AlbedoColor;
        if (u_TextureFlags.x > 0.5) {
            albedo *= SAMPLE(u_AlbedoTexture, v_TexCoord);
        }

        // Alpha test (u_MaterialParams2.x = alphaCutoff)
        if (albedo.a < u_MaterialParams2.x) {
            DISCARD;
        }

        // Unpack parameters with defaults
        // u_MaterialParams1: x=shadowSoftness, y=specularSoftness, z=normalScale, w=emissiveStrength
        float shadowSoftness = max(u_MaterialParams1.x, 0.3);
        float specularSoftness = max(u_MaterialParams1.y, 0.15);
        float normalScale = u_MaterialParams1.z;
        // u_MaterialParams2: x=alphaCutoff, y=rimPower, z=rimIntensity, w=specularPower
        float rimPower = u_MaterialParams2.y > 0.0 ? u_MaterialParams2.y : 2.5;
        float rimIntensity = u_MaterialParams2.z;
        float specularPower = u_MaterialParams2.w > 0.0 ? u_MaterialParams2.w : 24.0;
        // u_StylizedParams: x=shadowBrightness, y=shadowWarmth, z=specularIntensity, w=halfLambertPower
        float shadowBrightness = u_StylizedParams.x > 0.0 ? u_StylizedParams.x : 0.4;
        float shadowWarmth = u_StylizedParams.y >= 0.0 ? u_StylizedParams.y : 0.5;
        float specularIntensity = u_StylizedParams.z > 0.0 ? u_StylizedParams.z : 0.5;
        float halfLambertPower = u_StylizedParams.w > 0.0 ? u_StylizedParams.w : 1.5;

        // Normal mapping via getNormalFromMap (injected by #feature normal_mapping)
        vec3 N = getNormalFromMap();
        vec3 V = normalize(v_ViewDir);

        // Ambient from light UBO
        vec3 ambient = u_Lights.ambientLight.rgb;

        // Accumulate lighting from all dynamic lights
        vec3 totalLight = vec3(0.0);
        vec3 totalSpecular = vec3(0.0);
        int numLights = int(u_Lights.lightCounts.x);

        for (int i = 0; i < 16; i++) {
            if (i >= numLights) break;

            vec3 lightColor = u_Lights.lights[i].color.rgb;
            float lightIntensity = u_Lights.lights[i].color.w;
            int lightType = int(u_Lights.lights[i].flags.x);
            vec3 lightPos = u_Lights.lights[i].positionOrDirection.xyz;

            // Compute light direction
            vec3 L;
            float attenuation = 1.0;

            if (lightType == 0) {
                // Directional light
                L = normalize(-u_Lights.lights[i].direction.xyz);
            } else {
                // Point or spot light
                vec3 toLight = lightPos - v_WorldPos;
                float dist = length(toLight);
                L = normalize(toLight);
                float lightRange = u_Lights.lights[i].params.x;
                float distFactor = clamp(dist / lightRange, 0.0, 1.0);
                attenuation = 1.0 / (1.0 + distFactor * distFactor);
                attenuation *= smoothstep(1.0, 0.5, distFactor);

                if (lightType == 2) {
                    // Spot light cone attenuation
                    vec3 spotDir = normalize(-u_Lights.lights[i].direction.xyz);
                    float cosAngle = dot(L, spotDir);
                    float innerCone = u_Lights.lights[i].params.y;
                    float outerCone = u_Lights.lights[i].params.z;
                    float epsilon = max(innerCone - outerCone, 0.0001);
                    attenuation *= clamp((cosAngle - outerCone) / epsilon, 0.0, 1.0);
                }
            }

            // Half-Lambert diffuse with soft transitions
            float NdotL = dot(N, L);
            float diffuseRaw = halfLambert(NdotL, halfLambertPower);
            float softShadowEdge = shadowSoftness * 0.5;
            float diffuse = smoothstep(0.5 - softShadowEdge, 0.5 + softShadowEdge, diffuseRaw);

            // Specular calculation
            float specular = calculateSpecular(N, V, L, specularPower, specularSoftness, max(NdotL, 0.0));

            // Shadow
            float shadow = 1.0;
            if (u_ReceiveShadow != 0 && u_Lights.lights[i].flags.y > 0.5) {
                shadow = calculateShadow(int(u_Lights.lights[i].flags.z), v_WorldPos, N, L, lightPos);
            }

            vec3 litColor = lightColor * lightIntensity * attenuation * shadow;
            totalLight += litColor * diffuse;
            totalSpecular += litColor * specular * specularIntensity;
        }

        // Calculate average light intensity for shadow ramp
        float avgLight = (totalLight.r + totalLight.g + totalLight.b) / 3.0;
        float lightAmount = clamp(avgLight + length(ambient) * 0.5, 0.0, 1.0);

        // Apply shadow ramp to create stylized color shifts
        vec3 shadedColor = applyShadowRamp(lightAmount, albedo.rgb, shadowBrightness, shadowWarmth);

        // Rim lighting
        float rim = calculateRimLighting(N, V, rimPower, rimIntensity);
        vec3 rimColor = ambient * rim * 1.5;

        // Emissive (u_MaterialParams1.w = emissiveStrength)
        vec3 emissive = u_EmissiveColor.rgb * u_MaterialParams1.w;
        if (u_TextureFlags.w > 0.5) {
            emissive *= SAMPLE(u_EmissiveTexture, v_TexCoord).rgb;
        }

        // Final color composition
        vec3 diffuseColor = shadedColor * (ambient + totalLight);
        vec3 color = diffuseColor + totalSpecular + rimColor + emissive;

        // Apply tint
        color *= u_TintColor.rgb;

        // Distance fog
        color = applyFog(color, v_WorldPos, u_CameraPosition);

        // Soft HDR tonemapping
        color = color / (color + vec3(0.5));
        color = pow(color, vec3(0.95));

        // Gamma correction
        color = pow(color, vec3(1.0 / 2.2));

        FragColor = vec4(color, albedo.a);
    }
#end fragment
