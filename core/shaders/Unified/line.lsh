#shader "Line"
#description "Line rendering for 2D"

#begin properties
    uniform mat4 u_ViewProjection;
    uniform mat4 u_Model;
    uniform mat4 u_NormalMatrix;
    uniform vec4 u_TintColor = vec4(1.0);
#end properties

#begin vertex
    #input vec3 a_Position : POSITION 0
    #input vec4 a_Color : COLOR 1

    #output vec4 v_Color

    void main() {
        v_Color = a_Color;
        VERTEX_OUTPUT = MUL(u_ViewProjection, MUL(u_Model, vec4(a_Position, 1.0)));
    }
#end vertex

#begin fragment
    #output vec4 FragColor

    void main() {
        FragColor = v_Color * u_TintColor;
    }
#end fragment
