#shader "ShadowMapInstanced"
#description "GPU-instanced shadow map depth rendering (MultiMesh)"

#begin properties
    uniform mat4 u_ViewProjection;
    uniform mat4 u_Model;
    uniform sampler2D u_AlbedoTexture;
    uniform int u_HasAlbedoTexture = 0;
    uniform float u_AlphaCutoff = 0.0;
#end properties

#begin vertex
    #input vec3 a_Position : POSITION 0
    #input vec2 a_TexCoord : TEXCOORD0 2
    #input vec4 a_InstanceModel0 : TEXCOORD1 4
    #input vec4 a_InstanceModel1 : TEXCOORD2 5
    #input vec4 a_InstanceModel2 : TEXCOORD3 6
    #input vec4 a_InstanceModel3 : TEXCOORD4 7
    #input vec4 a_InstanceColor : TEXCOORD5 8
    #input vec4 a_InstanceCustom : TEXCOORD6 9

    #output vec2 v_TexCoord

    void main() {
        v_TexCoord = a_TexCoord;
        vec4 worldPos = a_InstanceModel0 * a_Position.x
                      + a_InstanceModel1 * a_Position.y
                      + a_InstanceModel2 * a_Position.z
                      + a_InstanceModel3;
        VERTEX_OUTPUT = MUL(u_ViewProjection, worldPos);
    }
#end vertex

#begin fragment
    #output vec4 FragColor

    void main() {
        if (u_HasAlbedoTexture == 1) {
            float alpha = SAMPLE(u_AlbedoTexture, v_TexCoord).a;
            if (alpha < u_AlphaCutoff) {
                DISCARD;
            }
        }
        FragColor = vec4(1.0);
    }
#end fragment
