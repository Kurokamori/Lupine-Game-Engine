{
  "name": "lupine-game-engine",
  "version": "1.0.0",
  "description": "Lupine Game Engine with Python Editor and C++ Runtime",
  "dependencies": [
    "assimp",
    "box2d",
    "bullet3",
    "enet",
    "entt",
    {
      "name": "ffmpeg",
      "default-features": false,
      "features": [
        "avcodec",
        "avformat",
        "swresample",
        "swscale"
      ]
    },
    "fmt",
    {
      "name": "ixwebsocket",
      "default-features": false
    },
    "glad",
    "glew",
    "glfw3",
    "glm",
    "glslang",
    "libiconv",
    "lua",
    "miniaudio",
    "nlohmann-json",
    "opengl",
    "polyclipping",
    "pybind11",
    "sdl2",
    "sol2",
    "spdlog",
    "stb",
    "directx-dxc",
    "vulkan",
    "vulkan-headers",
    "zlib"
  ],
  "features": {
    "opengl": {
      "description": "Enable OpenGL rendering backend",
      "dependencies": [
        "glad",
        "opengl"
      ]
    },
    "vulkan": {
      "description": "Enable Vulkan rendering backend",
      "dependencies": [
        "vulkan",
        "vulkan-headers"
      ]
    }
  }
}
